.ipynb_checkpoints/

# ─── Build / packaging artifacts ─────────────────────────────────────────
*.whl
*.tar.gz
!requirements*.tar.gz

# ─── PyPI credentials (DO NOT COMMIT) ────────────────────────────────────
.pypirc
.twine/
*.pypirc
!pypirc.example

# ─── Environment / secrets ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.token
*.secret

# ─── Editors / IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ─── OS / system ─────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ─── Logs ────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Temporary files ─────────────────────────────────────────────────────
*.tmp
*.bak
*.bak[0-9]*
*.bak.*
*.orig
*.rej

# ─── Netlify ─────────────────────────────────────────────────────────────
.netlify/

# ─── Project-specific ────────────────────────────────────────────────────
# Keep experiment results (they are part of the record)
!experiments/*/results.json

# Keep paper artifacts
!PUBLICATION/*.pdf
!PUBLICATION/*.md
!PUBLICATION/Netlify/public/*.html

# Keep docs / figures
!docs/figures/*.png

# Keep specification
!docs/specification/*.md

# Ignore local notes
notes/
TODO.local.md
scratch/
